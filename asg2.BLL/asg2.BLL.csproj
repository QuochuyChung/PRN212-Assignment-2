<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- RÀNG BUỘC KIẾN TRÚC: PrivateAssets="compile" để kiểu của DAL (và EF Core) KHÔNG "chảy" sang tầng Web
         lúc biên dịch. Giữ đúng dạng này, tools/check-layers.ps1 kiểm tra theo chuỗi này. -->
    <ProjectReference Include="..\asg2.DAL\asg2.DAL.csproj" PrivateAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <InternalsVisibleTo Include="test-question-picker" />
  </ItemGroup>

</Project>
