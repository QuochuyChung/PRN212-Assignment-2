@page
@model asg2.Web.Pages.Admin.Sessions.CreateModel
@{
    ViewData["Title"] = "Tạo phiên thi";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3" title="Quay lại danh sách">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                </svg>
                Quay lại
            </a>
            <div>
                <h1 class="h3 mb-0 fw-bold">Tạo phiên thi mới</h1>
                <div class="text-muted small">Thiết lập thời gian, phòng thi và tiêu chuẩn vấn đáp cho ca thi</div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- 1. Thông tin chung -->
                    <div class="form-section-title">1. Thông tin cơ bản</div>
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label"></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Ví dụ: Thi vấn đáp PRN222 - Ca sáng" />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.SubjectId" class="form-label"></label>
                            <select asp-for="Input.SubjectId" class="form-select">
                                <option value="">-- Chọn môn học --</option>
                                @foreach (var s in Model.Subjects)
                                {
                                    <option value="@s.Id">@s.Code - @s.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Input.SubjectId" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.RoomId" class="form-label"></label>
                            <select asp-for="Input.RoomId" class="form-select">
                                <option value="">-- Chọn phòng thi --</option>
                                @foreach (var r in Model.Rooms)
                                {
                                    <option value="@r.Id">@r.Name @(!string.IsNullOrEmpty(r.Building) ? $"({r.Building})" : "")</option>
                                }
                            </select>
                            <span asp-validation-for="Input.RoomId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 2. Thời gian tổ chức -->
                    <div class="form-section-title">2. Thời gian tổ chức</div>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.StartTime" class="form-label"></label>
                            <input asp-for="Input.StartTime" type="datetime-local" class="form-control"
                                   value="@Model.Input.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="Input.StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Input.EndTime" class="form-label"></label>
                            <input asp-for="Input.EndTime" type="datetime-local" class="form-control"
                                   value="@Model.Input.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="Input.EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 3. Cấu hình vấn đáp -->
                    <div class="form-section-title">3. Quy chuẩn vấn đáp</div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="Input.SlotMinutes" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.SlotMinutes" type="number" class="form-control" min="5" max="180" />
                                <span class="input-group-text bg-light text-muted">phút</span>
                            </div>
                            <span asp-validation-for="Input.SlotMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Input.MainQuestionCount" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.MainQuestionCount" type="number" class="form-control" min="1" max="20" />
                                <span class="input-group-text bg-light text-muted">câu</span>
                            </div>
                            <span asp-validation-for="Input.MainQuestionCount" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Input.MaxFollowUpCount" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.MaxFollowUpCount" type="number" class="form-control" min="0" max="10" />
                                <span class="input-group-text bg-light text-muted">câu phụ</span>
                            </div>
                            <span asp-validation-for="Input.MaxFollowUpCount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted mb-4 border">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1 text-primary align-text-bottom" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                        </svg>
                        <strong>Lưu ý:</strong> Sức chứa tối đa (Capacity) của phiên thi sẽ được hệ thống tự động tính toán dựa trên tổng thời gian và thời lượng mỗi slot.
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-page="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary shadow-sm px-4">Tạo phiên thi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

