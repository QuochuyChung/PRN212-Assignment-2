@page
@model asg2.Web.Pages.Admin.Accounts.IndexModel
@{
    ViewData["Title"] = "Tài khoản sinh viên";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Tài khoản sinh viên</h1>
    <a class="btn btn-primary" asp-page="Create">+ Thêm tài khoản</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5 col-lg-4">
        <input type="search" name="q" value="@Model.Q" class="form-control" placeholder="Tìm theo tên đăng nhập hoặc họ tên" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q))
        {
            <a class="btn btn-link" asp-page="Index">Xóa lọc</a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên đăng nhập</th>
                <th>Họ tên</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody id="accounts-body" data-filtered="@(!string.IsNullOrWhiteSpace(Model.Q) ? "true" : "false")">
            @foreach (var account in Model.Accounts)
            {
                <tr data-id="@account.Id">
                    <td class="col-username">@account.Username</td>
                    <td class="col-fullname">@account.FullName</td>
                    <td class="col-status">
                        @if (account.IsActive)
                        {
                            <span class="badge text-bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Đã khóa</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@account.Id">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@account.Id">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p id="accounts-empty" class="text-muted" @(Model.Accounts.Count > 0 ? "hidden" : "")>Chưa có tài khoản sinh viên nào.</p>

@section Scripts {
    <script src="~/js/account-list.js" asp-append-version="true"></script>
}
