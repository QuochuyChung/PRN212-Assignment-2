@page
@model asg2.Web.Pages.Admin.Accounts.CreateModel
@{
    ViewData["Title"] = "Thêm tài khoản";
    ViewData["PasswordHint"] = "Tối thiểu 6 ký tự.";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3" title="Quay lại danh sách">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                </svg>
                Quay lại
            </a>
            <div>
                <h1 class="h3 mb-0 fw-bold">Thêm tài khoản sinh viên</h1>
                <div class="text-muted small">Cấp thông tin đăng nhập và kích hoạt tài khoản cho sinh viên</div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <partial name="_AccountForm" for="Input" view-data="ViewData" />
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a class="btn btn-outline-secondary" asp-page="Index">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary shadow-sm px-4">Tạo tài khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

