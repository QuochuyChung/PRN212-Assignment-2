@page
@model asg2.Web.Pages.Admin.Accounts.DeleteModel
@{
    ViewData["Title"] = "Xóa tài khoản";
}

<h1 class="h3 mb-3">Xóa tài khoản sinh viên</h1>

<div class="row">
    <div class="col-12 col-md-8 col-lg-5">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <p>Bạn có chắc muốn xóa tài khoản sau? Thao tác này không thể hoàn tác.</p>
        <dl class="row">
            <dt class="col-sm-4">Tên đăng nhập</dt>
            <dd class="col-sm-8">@Model.Account!.Username</dd>
            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8">@Model.Account.FullName</dd>
            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">@(Model.Account.IsActive ? "Hoạt động" : "Đã khóa")</dd>
        </dl>
        <p class="text-muted small">Nếu tài khoản đã có lịch thi, hệ thống sẽ không cho xóa; hãy khóa tài khoản ở trang Sửa.</p>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a class="btn btn-link" asp-page="Index">Hủy</a>
        </form>
    </div>
</div>
