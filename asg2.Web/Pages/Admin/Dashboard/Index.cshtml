@page
@model asg2.Web.Pages.Admin.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-3">Dashboard</h1>

<div class="row g-3" id="dashboard-stats">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Môn học</div>
                <div class="fs-4 fw-semibold" id="stat-total-subjects">@Model.Stats.TotalSubjects</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Phòng thi</div>
                <div class="fs-4 fw-semibold" id="stat-total-rooms">@Model.Stats.TotalRooms</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Phòng đang dùng</div>
                <div class="fs-4 fw-semibold" id="stat-active-rooms">@Model.Stats.ActiveRooms</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Sinh viên</div>
                <div class="fs-4 fw-semibold" id="stat-total-students">@Model.Stats.TotalStudents</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Phiên thi</div>
                <div class="fs-4 fw-semibold" id="stat-total-sessions">@Model.Stats.TotalSessions</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Câu hỏi</div>
                <div class="fs-4 fw-semibold" id="stat-total-questions">@Model.Stats.TotalQuestions</div>
            </div>
        </div>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">Số liệu tự làm mới khi admin ở bất kỳ trang nào nhận sự kiện realtime.</p>
