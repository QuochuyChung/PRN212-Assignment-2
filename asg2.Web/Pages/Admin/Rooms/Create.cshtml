@page
@model asg2.Web.Pages.Admin.Rooms.CreateModel
@{
    ViewData["Title"] = "Thêm phòng thi";
}

<h1 class="h3 mb-3">Thêm phòng thi</h1>

<div class="row">
    <div class="col-12 col-md-8 col-lg-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <partial name="_RoomForm" for="Input" />
            <button type="submit" class="btn btn-primary">Tạo phòng</button>
            <a class="btn btn-link" asp-page="Index">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
