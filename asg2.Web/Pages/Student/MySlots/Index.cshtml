@page
@model asg2.Web.Pages.Student.MySlots.IndexModel
@{
    ViewData["Title"] = "Lịch thi của tôi";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1 fw-bold">Lịch thi của tôi</h1>
        <div class="text-muted small">Các ca thi vấn đáp bạn đã được xếp lịch (tự động cập nhật ngay khi giáo viên gán hoặc đổi giờ)</div>
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert" style="background-color: #f0f9ff; color: #0369a1; border-left: 4px solid #0284c7 !important;">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="flex-shrink-0" viewBox="0 0 16 16">
        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
    </svg>
    <div class="small">
        <strong>Lưu ý quan trọng cho thí sinh:</strong> Vui lòng có mặt tại phòng thi trước ca thi của mình ít nhất 10 phút và chuẩn bị sẵn thẻ sinh viên hoặc giấy tờ tùy thân.
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Phiên thi</th>
                    <th>Môn học</th>
                    <th>Phòng thi</th>
                    <th>Ngày thi</th>
                    <th>Giờ thi của bạn</th>
                    <th>Thứ tự (Slot)</th>
                    <th class="pe-3">Câu hỏi</th>
                </tr>
            </thead>
            <tbody id="my-slots-body">
                @foreach (var slot in Model.MySlots)
                {
                    <tr data-slot-id="@slot.Id" data-session-id="@slot.SessionId">
                        <td class="col-title ps-3 fw-bold">@slot.SessionTitle</td>
                        <td class="col-subject">
                            <span class="badge badge-soft-primary">@slot.SubjectCode</span>
                            <div class="small text-muted">@slot.SubjectName</div>
                        </td>
                        <td class="col-room">
                            <span class="badge badge-soft-info">@slot.RoomName</span>
                        </td>
                        <td class="col-date">@slot.StartTime.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="col-hours">
                            <span class="badge badge-soft-success fs-6 fw-bold">
                                @slot.StartTime.ToLocalTime().ToString("HH:mm") - @slot.EndTime.ToLocalTime().ToString("HH:mm")
                            </span>
                        </td>
                        <td class="col-order">
                            <span class="badge badge-soft-primary px-2 py-1 fw-bold">Slot #@slot.OrderNo</span>
                        </td>
                        <td class="col-questions pe-3">
                            <a asp-page="/Student/SlotDetail/Index" asp-route-slotId="@slot.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 py-1 px-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                    <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94"/>
                                </svg>
                                <span>Xem đề (@slot.MainQuestionCount câu)</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="my-slots-empty" class="empty-state" @(Model.MySlots.Count > 0 ? "hidden" : "")>
        <div class="empty-state-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
            </svg>
        </div>
        <div class="fw-semibold text-dark mb-1">Bạn chưa có lịch thi nào được xếp</div>
        <div class="small">Khi giáo viên xếp ca thi vấn đáp cho bạn, thông tin chi tiết sẽ lập tức hiển thị tại đây.</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/my-slots.js" asp-append-version="true"></script>
}

